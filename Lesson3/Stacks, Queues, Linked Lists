aH.push('Opened Ticket #101');
aH.push('Assigned Ticket #101');
aH.push('Closed Ticket #101');

console.log('Top Action: ' + aH.peek());

let uA = aH.pop();

console.log('Undo Action: ' + uA);
console.log('Remaining Actions: ' + aH.toString());
console.log('Stack Size: ' + aH.size());


// PART B: QUEUE


class Queue {
    constructor() {
        this.items = [];
    }

    enqueue(element) {
        this.items.push(element);
    }

    dequeue() {
        return this.items.shift();
    }

    front() {
        return this.items[0];
    }

    isEmpty() {
        return this.items.length === 0;
    }

    size() {
        return this.items.length;
    }

    toString() {
        return this.items.join(', ');
    }
}

